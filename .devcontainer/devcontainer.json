{
  "name": "Monster Girl Delivery",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    }
  },

  "secrets": {
    "MGD_GH_TOKEN": {
      "description": "Fine-grained GitHub PAT scoped to bongohorse/monster-girl-delivery"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "postStartCommand": "grep -qxF 'export GH_TOKEN=\"$MGD_GH_TOKEN\"' ~/.bashrc || echo 'export GH_TOKEN=\"$MGD_GH_TOKEN\"' >> ~/.bashrc",

  "forwardPorts": [8080],

  "portsAttributes": {
    "8080": {
      "label": "Vite Development Server",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "workbench.secondarySideBar.defaultVisibility": "hidden"
      },
      "extensions": ["biomejs.biome"]
    }
  }
}
