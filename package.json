{
  "name": "monster-girl-delivery",
  "description": "Mobile-first Phaser 4 game foundation.",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bongohorse/monster-girl-delivery.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/bongohorse/monster-girl-delivery/issues"
  },
  "homepage": "https://bongohorse.github.io/monster-girl-delivery/",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080 --config vite/config.prod.mjs",
    "check": "biome check --write .",
    "ci:check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "bun add --dev --no-save --exact @vitest/coverage-istanbul@5.0.1 && vitest run --coverage.enabled"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "terser": "^5.51.2",
    "typescript": "7.0.2",
    "vite": "^8.1.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
