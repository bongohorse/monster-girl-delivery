{
  "name": "monster-girl-delivery",
  "description": "Mobile-first Phaser 4 game foundation.",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bongohorse/monster-girl-delivery.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/bongohorse/monster-girl-delivery/issues"
  },
  "homepage": "https://bongohorse.github.io/monster-girl-delivery/",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080 --config vite/config.prod.mjs",
    "check": "biome check --write .",
    "ci:check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage.enabled",
    "test:mutation:collectibles": "stryker run stryker.collectibles.config.mjs",
    "android:sync": "bun run build && node scripts/verify-android-launcher-assets.mjs && cap sync android",
    "android:open": "bun run android:sync && cap open android",
    "android:debug": "bun run android:sync && node scripts/android-gradle.mjs assembleDebug"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@capacitor/cli": "8.5.2",
    "@stryker-mutator/core": "10.0.0",
    "@vitest/coverage-istanbul": "5.0.1",
    "terser": "^5.51.2",
    "typescript": "7.0.2",
    "vite": "^8.1.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "phaser": "4.2.1"
  }
}
